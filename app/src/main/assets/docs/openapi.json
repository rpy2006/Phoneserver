{
  "openapi": "3.0.3",
  "info": {
    "title": "PhoneServer API",
    "version": "1.0.0",
    "description": "Implemented local data, storage, token, mail, and system-management APIs served by PhoneServer on port 8080."
  },
  "servers": [
    {
      "url": "http://{deviceIp}:8080/api/v1",
      "variables": {
        "deviceIp": {
          "default": "DEVICE_IP"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Public liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is online"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Authenticated endpoint index",
        "responses": {
          "200": {
            "description": "Endpoint patterns"
          }
        }
      }
    },
    "/system": {
      "get": {
        "summary": "Legacy system statistics (admin only)",
        "responses": {
          "200": {
            "description": "Statistics"
