<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_bg" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/back_button" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back_arrow"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Developer Sandbox" android:textColor="@color/home_text_primary" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/run_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Run" android:textColor="@color/home_accent" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Isolated test mode. Actions do not modify production files, campaigns, or server config." android:textColor="@color/home_text_secondary" android:paddingTop="8dp" android:paddingBottom="8dp"/>
    <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="160dp" android:background="@drawable/bg_home_card" android:gravity="top" android:padding="12dp" android:textColor="@color/home_text_primary" android:textSize="12sp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"><TextView android:id="@+id/output" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_card" android:padding="12dp" android:textColor="@color/home_text_secondary" android:textIsSelectable="true"/></ScrollView>
</LinearLayout>
