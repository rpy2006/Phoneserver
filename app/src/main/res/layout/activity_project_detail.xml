<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Project"
            android:textColor="@color/home_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Loading..." />

                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:text="" />

                <TextView
                    android:id="@+id/detail_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="id: -" />

                <TextView
                    android:id="@+id/detail_created"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="" />

                <TextView
                    android:id="@+id/detail_updated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="" />

                <TextView
                    android:id="@+id/detail_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/home_text_primary"
                android:textSize="13sp"
                android:id="@+id/detail_stats"
                android:text="Loading usage..." />

            <TextView
                android:id="@+id/card_databases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:drawablePadding="14dp"
                android:gravity="center_vertical"
                android:text="Databases — SQL workspaces"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:text="Files — browse, upload, download"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_backups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:text="Backups — create, restore, download"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:text="Settings — rename, description, quotas"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_api_docs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:text="API Documentation"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
