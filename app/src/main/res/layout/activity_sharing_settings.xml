<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sharing Settings"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Defaults for new links"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default expiry (minutes)"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1440"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use 0 for no expiry. 1440 minutes is 24 hours."
                    android:textColor="@color/home_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default maximum downloads"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0 = unlimited"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default permission"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/permission_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Require a password by default"
                            android:textColor="@color/home_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New links start protected"
                            android:textColor="@color/home_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:track="@drawable/switch_track" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/settings_security_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Checking HTTPS configuration…"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Link secrets and passwords are stored as salted hashes in app-private storage. Password unlock sessions are kept in memory and expire after 30 minutes."
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save settings"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
