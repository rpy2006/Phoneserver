<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New Task"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task name"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nightly backup"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/action_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/project_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/project_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_outline"
                        android:padding="14dp"
                        android:minHeight="52dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/webhook_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Webhook"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/webhook_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_outline"
                        android:padding="14dp"
                        android:minHeight="52dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/schedule_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/run_at_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Run at (yyyy-MM-dd HH:mm)"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/input_run_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="2026-11-20 02:00"
                        android:background="@drawable/bg_input_outline"
                        android:textColor="@color/home_text_primary"
                        android:textColorHint="@color/home_text_secondary"
                        android:padding="14dp"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum attempts"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_max_attempts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry delay (minutes)"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_retry_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="5"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Run every (minutes)"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1440"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Include files in backups"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switch_include_files"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:track="@drawable/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enabled"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switch_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:track="@drawable/switch_track" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/run_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Run now"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_outline"
                    android:textColor="@color/home_text_primary"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save task"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/delete_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Delete task"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_red"
                    android:textColor="@android:color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
