<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="API Editor"
            android:textColor="@color/home_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/save_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_check" />

        <ImageView
            android:id="@+id/delete_button"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- Endpoint + Method -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Endpoint"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/endpoint_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="/api/data"
                        android:background="@drawable/bg_input_outline"
                        android:textColor="@color/home_text_primary"
                        android:textColorHint="@color/home_text_secondary"
                        android:padding="14dp"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Method"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/method_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_outline"
                        android:padding="14dp"
                        android:minHeight="52dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Headers"
                    android:textColor="@color/home_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/add_header_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ ADD HEADER"
                    android:textColor="@color/home_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/headers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp" />

            <!-- Parameters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Parameters"
                    android:textColor="@color/home_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/add_param_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ ADD PARAMETER"
                    android:textColor="@color/home_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/params_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parameters are documentation only right now - they're shown here for reference but not enforced when a request comes in."
                android:textColor="@color/home_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="20dp" />

            <!-- Body -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Body"
                android:textColor="@color/home_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_home_card">

                <TextView
                    android:id="@+id/line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@color/home_bg"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:text="1"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    android:typeface="monospace"
                    android:gravity="top|end"
                    android:lineSpacingMultiplier="1.05" />

                <EditText
                    android:id="@+id/body_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:text="{\n  &quot;key&quot;: &quot;value&quot;\n}"
                    android:textColor="@color/home_text_primary"
                    android:padding="14dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:typeface="monospace"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.05"
                    android:scrollHorizontally="false"
                    android:overScrollMode="always" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
