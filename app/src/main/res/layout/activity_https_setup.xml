<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HTTPS &amp; Domain"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HTTPS runs alongside the normal HTTP server. Pairing QR codes pin the certificate fingerprint, so a self-signed certificate is safe for local use."
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enable HTTPS"
                                android:textColor="@color/home_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TLS server on a separate port"
                                android:textColor="@color/home_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_https"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:track="@drawable/switch_track" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HTTPS port"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/input_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_outline"
                        android:hint="8443"
                        android:inputType="number"
                        android:maxLength="5"
                        android:padding="12dp"
                        android:textColor="@color/home_text_primary"
                        android:textColorHint="@color/home_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friendly hostname"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/input_hostname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_outline"
                        android:hint="phoneserver.local"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/home_text_primary"
                        android:textColorHint="@color/home_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Public or tunnel URL (optional)"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />

                    <EditText
                        android:id="@+id/input_public_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_outline"
                        android:hint="https://server.example.com"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/home_text_primary"
                        android:textColorHint="@color/home_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Include local IP in QR"
                                android:textColor="@color/home_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Uses the current Wi-Fi address for pairing"
                                android:textColor="@color/home_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_local_ip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:track="@drawable/switch_track" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Certificate"
                        android:textColor="@color/home_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cert_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No certificate yet"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/fingerprint_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/home_text_secondary"
                        android:textSize="10sp"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/generate_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_card"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Generate self-signed certificate"
                        android:textColor="@color/home_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/import_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Import PKCS#12 certificate"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_fab_circle"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Save and restart server"
                    android:textColor="@color/home_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
