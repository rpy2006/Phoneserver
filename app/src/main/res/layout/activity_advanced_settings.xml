<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Advanced Settings"
            android:textColor="@color/home_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/row_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:layout_marginBottom="10dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_home_icon_circle">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_folder" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear Cache" android:textColor="@color/home_text_primary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/cache_size_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temporary files used for previews" android:textColor="@color/home_text_secondary" android:textSize="12sp" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_reset_endpoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_home_icon_circle">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_close_small" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset Custom API Endpoints" android:textColor="@color/home_text_primary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Removes everything defined in the API Editor" android:textColor="@color/home_text_secondary" android:textSize="12sp" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Data platform configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data root" android:textColor="@color/home_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folder holding all projects, databases, files and backups." android:textColor="@color/home_text_secondary" android:textSize="12sp" android:layout_marginTop="1dp" />

            <EditText
                android:id="@+id/data_root_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:padding="10dp"
                android:inputType="text"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:textColor="@color/home_text_primary"
                android:textColorHint="@color/home_text_secondary"
                android:textSize="12sp"
                android:hint="/storage/..." />

            <TextView
                android:id="@+id/save_data_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_light"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Save"
                android:textColor="@color/home_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allowed CORS origins" android:textColor="@color/home_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&quot;*&quot; allows any website. Empty disables cross-origin access (same-origin only). Otherwise a comma-separated list, e.g. https://app.example.com,https://site.example.com" android:textColor="@color/home_text_secondary" android:textSize="12sp" android:layout_marginTop="1dp" />

            <EditText
                android:id="@+id/allowed_origins_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:padding="10dp"
                android:inputType="text"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:textColor="@color/home_text_primary"
                android:textColorHint="@color/home_text_secondary"
                android:textSize="12sp"
                android:hint="*" />

            <TextView
                android:id="@+id/save_allowed_origins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_light"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Save"
                android:textColor="@color/home_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API rate limit per minute" android:textColor="@color/home_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maximum data API requests allowed per client IP each minute (minimum 10)." android:textColor="@color/home_text_secondary" android:textSize="12sp" android:layout_marginTop="1dp" />

            <EditText
                android:id="@+id/rate_limit_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:padding="10dp"
                android:inputType="number"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:textColor="@color/home_text_primary"
                android:textColorHint="@color/home_text_secondary"
                android:textSize="12sp"
                android:hint="240" />

            <TextView
                android:id="@+id/save_rate_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_light"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Save"
                android:textColor="@color/home_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

</LinearLayout>
