<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New Share"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Link name"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Holiday photos"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shared path"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/path_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_outline"
                        android:text="No file or folder selected"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp"
                        android:padding="14dp"
                        android:maxLines="2"
                        android:ellipsize="middle" />

                    <Button
                        android:id="@+id/browse_button"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:text="Browse"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button_outline"
                        android:textColor="@color/home_text_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/type_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permission"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/permission_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/expiry_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/input_custom_hours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Custom hours (for example 1.5)"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum downloads"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_max_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0 = unlimited"
                    android:inputType="number"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Optional password"
                    android:inputType="textVisiblePassword"
                    android:background="@drawable/bg_input_outline"
                    android:textColor="@color/home_text_primary"
                    android:textColorHint="@color/home_text_secondary"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:layout_marginBottom="6dp" />

                <CheckBox
                    android:id="@+id/remove_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Remove password protection"
                    android:textColor="@color/home_text_primary"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save share link"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/share_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_home_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share link"
                        android:textColor="@color/home_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/share_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/home_accent"
                        android:textSize="13sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/share_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/offline_red"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/token_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The link secret is only shown now and is stored as a hash. Rotate it if you need a new copy."
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:paddingBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/copy_button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Copy"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_button_outline"
                            android:textColor="@color/home_text_primary" />

                        <Button
                            android:id="@+id/qr_button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="QR code"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_button_primary"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/history_button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="View access history"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button_outline"
                        android:textColor="@color/home_text_primary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/rotate_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Rotate link secret"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_outline"
                    android:textColor="@color/home_text_primary"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/revoke_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Revoke access"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_outline"
                    android:textColor="@color/home_text_primary"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/delete_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Delete share link"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_red"
                    android:textColor="@android:color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
