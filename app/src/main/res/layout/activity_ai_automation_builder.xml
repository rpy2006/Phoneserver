<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/home_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="12dp">
                <ImageView android:id="@+id/back_button" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back_arrow"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Automation Builder" android:textColor="@color/home_text_primary" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_card" android:orientation="vertical" android:padding="16dp">
                <EditText android:id="@+id/ai_auto_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Automation name"/>
                <EditText android:id="@+id/ai_auto_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Action: backup or webhook"/>
                <EditText android:id="@+id/ai_auto_project" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Project ID (for backup)"/>
                <EditText android:id="@+id/ai_auto_webhook" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Webhook ID (for webhook action)"/>
                <EditText android:id="@+id/ai_auto_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Interval minutes" android:inputType="number"/>
                <Button android:id="@+id/ai_auto_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create Automation"/>
            </LinearLayout>
            <TextView android:id="@+id/ai_auto_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_card" android:padding="16dp" android:textColor="@color/home_text_primary" android:textIsSelectable="true"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
