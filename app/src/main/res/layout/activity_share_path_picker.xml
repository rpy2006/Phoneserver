<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose file"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:text="Browse the public files folder."
            android:textColor="@color/home_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/current_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:text="/"
            android:textColor="@color/home_accent"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="middle" />

        <LinearLayout
            android:id="@+id/storage_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_home_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only PhoneServer's app folder is visible. Grant all-files access to share files from Pictures, Download, DCIM and other device folders."
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/grant_access_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="Grant access"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_primary"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/up_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Up"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_outline"
                android:textColor="@color/home_text_primary" />

            <Button
                android:id="@+id/use_folder_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Use this folder"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_primary"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/path_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/path_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="This folder is empty."
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
