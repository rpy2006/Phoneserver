<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp">

    <EditText
        android:id="@+id/row_key_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:hint="Key"
        android:background="@drawable/bg_input_outline"
        android:textColor="@color/home_text_primary"
        android:textColorHint="@color/home_text_secondary"
        android:padding="12dp"
        android:singleLine="true" />

    <EditText
        android:id="@+id/row_value_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Value"
        android:background="@drawable/bg_input_outline"
        android:textColor="@color/home_text_primary"
        android:textColorHint="@color/home_text_secondary"
        android:padding="12dp"
        android:singleLine="true" />

    <ImageView
        android:id="@+id/row_delete_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_close_small" />

</LinearLayout>
