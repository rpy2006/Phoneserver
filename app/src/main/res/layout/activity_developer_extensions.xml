<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_bg" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/back_button" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back_arrow"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Extension Manager" android:textColor="@color/home_text_primary" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/install_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Install" android:textColor="@color/home_accent" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manifest-based extensions only. No executable code. Admin approval required before enable." android:textColor="@color/home_text_secondary" android:paddingTop="8dp" android:paddingBottom="12dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_card" android:padding="16dp" android:textColor="@color/home_text_secondary" android:textIsSelectable="true"/></ScrollView>
</LinearLayout>
