<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/endpoint_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="/api/files"
        android:textColor="@color/home_text_primary"
        android:textSize="13sp"
        android:ellipsize="end"
        android:singleLine="true" />

    <FrameLayout
        android:id="@+id/endpoint_bar_track"
        android:layout_width="110dp"
        android:layout_height="6dp"
        android:background="@color/home_divider"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <View
            android:id="@+id/endpoint_bar_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/home_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/endpoint_count"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="48 (37%)"
        android:textColor="@color/home_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
