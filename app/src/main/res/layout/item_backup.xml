<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_home_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_home_icon_circle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_history"
            android:tint="@color/home_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/backup_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/home_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            android:text="backup.zip" />

        <TextView
            android:id="@+id/backup_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/home_text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:layout_marginTop="1dp"
            android:text="" />
    </LinearLayout>

    <ImageView
        android:id="@+id/backup_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/home_text_secondary" />

</LinearLayout>
